console_title_template = '{{ .Shell }} in {{ .Folder }}'
version = 3
final_space = true

[palette]
  green = '#DCD7BA'
  lavender = '#DCD7BA'
  mauve = '#C8C093'
  red = '#E46876'
  teal = '#D27E99'
  text = '#C8C093'
  trans = '#00000000'
  yellow = '#FF9E3B'

[secondary_prompt]
  template = ' '
  foreground = 'p:mauve'
  background = 'transparent'

[transient_prompt]
  template = ' '
  background = 'transparent'
  foreground_templates = ['{{if gt .Code 0}}p:red{{end}}', '{{if eq .Code 0}}p:lavender{{end}}']

[[blocks]]
  type = 'prompt'
  alignment = 'left'
  newline = true

  [[blocks.segments]]
    leading_diamond = ''
    trailing_diamond = '<transparent,p:teal></>'
    template = ' {{.Icon}} '
    foreground = 'transparent'
    background = 'p:teal'
    type = 'os'
    style = 'diamond'

    [blocks.segments.properties]
      cache_duration = 'none'

  [[blocks.segments]]
    leading_diamond = ''
    template = ' {{ if contains "dev" .Path }} {{ else }} {{ end }} '
    foreground = 'transparent'
    background = 'p:green'
    type = 'path'
    style = 'diamond'

    [blocks.segments.properties]
      cache_duration = 'none'
      style = 'full'

  [[blocks.segments]]
    trailing_diamond = '<transparent,p:green></>'
    template = ' {{.UserName}} '
    foreground = 'transparent'
    background = 'p:green'
    type = 'shell'
    style = 'diamond'

    [blocks.segments.properties]
      cache_duration = 'none'

  [[blocks.segments]]
    leading_diamond = ''
    trailing_diamond = '<transparent,p:mauve></>'
    template = '{{ .Path }} '
    foreground = 'transparent'
    background = 'p:mauve'
    type = 'path'
    style = 'diamond'

    [blocks.segments.properties]
      cache_duration = 'none'
      folder_icon = '󰉋 '
      folder_separator_template = '<transparent>  </>'
      home_icon = '   '
      style = 'full'

  [[blocks.segments]]
    leading_diamond = ''
    trailing_diamond = '<transparent,p:red></>'
    template = '   {{ .HEAD }}{{ if or (.Working.Changed) (.Staging.Changed) }}  {{ end }} <cyan>{{ if gt .Behind 0 }}⇣{{ end }}{{ if gt .Ahead 0 }}⇡{{ end }}</>'
    foreground = 'transparent'
    background = 'p:red'
    type = 'git'
    style = 'diamond'

    [blocks.segments.properties]
      branch_icon = ''
      cache_duration = 'none'
      commit_icon = '@'
      fetch_status = true

[[blocks]]
  type = 'rprompt'
  alignment = 'left'

  [[blocks.segments]]
    template = '{{ .FormattedMs }}'
    foreground = 'yellow'
    background = 'transparent'
    type = 'executiontime'
    style = 'plain'

    [blocks.segments.properties]
      cache_duration = 'none'
      threshold = 5000

[[blocks]]
  type = 'prompt'
  alignment = 'left'
  newline = true

  [[blocks.segments]]
    template = '<f>\ue0b6 </f>'
    background = 'transparent'
    type = 'text'
    style = 'plain'
    foreground_templates = ['{{if gt .Code 0}}p:red{{end}}', '{{if eq .Code 0}}p:lavender{{end}}']

    [blocks.segments.properties]
      cache_duration = 'none'
